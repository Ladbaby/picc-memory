  "type": "module",
  "description": "Claude Code style memory system for pi: CLAUDE.md layers (Managed / User / Project / Local / .claude/rules/) + AutoMem (persistent personal memory) + /memory command.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "memory",
    "claude-code",
    "CLAUDE.md",
    "automem",
    "MEMORY.md"
  ],
  "license": "MIT",
  "files": [
    "src/",
    "README.md",
    "package.json",
    "tsconfig.json"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}